  "item": [
    {
      "name": "Authentication",
      "description": "Registration, login and logout endpoints. Login and Register do not require authentication.",
      "item": [
        {
          "name": "Register",
          "request": {
            "url": {
              "host": "{{baseUrl}}",
              "path": "api/v1/auth/register",
              "query": [],
              "raw": "{{baseUrl}}/api/v1/auth/register"
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"johndoe\",\"password\":\"secret123\",\"password_confirmation\":\"secret123\"}"
            },
            "description": "Registers the user and returns an access token. Requires password_confirmation.",
            "auth": { "type": "noauth" }
          },
          "response": [
            {
              "name": "Success 201",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 201,
              "body": "{\n  \"token\": \"a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5\",\n  \"role\": \"USER\"\n}"
            },
            {
              "name": "Invalid data 422",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 422,
              "body": "{\n  \"message\": \"Invalid data\"\n}"
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "url": {
              "host": "{{baseUrl}}",
              "path": "api/v1/auth/login",
              "query": [],
              "raw": "{{baseUrl}}/api/v1/auth/login"
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"admin\",\"password\":\"admin123\"}"
            },
            "description": "Authenticates the user and returns an access token.",
            "auth": { "type": "noauth" }
          },
          "response": [
            {
              "name": "Success 200",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 200,
              "body": "{\n  \"token\": \"a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5\",\n  \"role\": \"ADMIN\"\n}"
            },
            {
              "name": "Invalid login 422",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 422,
              "body": "{\n  \"message\": \"Invalid login\"\n}"
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "url": {
              "host": "{{baseUrl}}",
              "path": "api/v1/auth/logout",
              "query": [],
              "raw": "{{baseUrl}}/api/v1/auth/logout"
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": null,
            "description": "Invalidates the current user token. Requires Bearer token."
          },
          "response": [
            {
              "name": "Success 200",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 200,
              "body": "{\n  \"message\": \"logout success\"\n}"
            },
            {
              "name": "Unauthorized 401",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 401,
              "body": "{\n  \"message\": \"Unauthorized user\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Events",
      "description": "Event management endpoints.",
      "item": [
        {
          "name": "List Events",
          "request": {
            "url": {
              "host": "{{baseUrl}}",
              "path": "api/v1/events",
              "query": [
                { "key": "page",   "value": "1",          "description": "Page number (default: 1).", "disabled": false },
                { "key": "date",   "value": "2026-05-01", "description": "Filter by event_date (YYYY-MM-DD).", "disabled": false },
                { "key": "search", "value": "Almaty",     "description": "Search substring in title or location.", "disabled": false }
              ],
              "raw": "{{baseUrl}}/api/v1/events?page=1&date=2026-05-01&search=Almaty"
            },
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": null,
            "description": "Returns a paginated list of events. registrations_count reflects only CONFIRMED registrations."
          },
          "response": [
            {
              "name": "Success 200",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 200,
              "body": "{\n  \"data\": [\n    {\n      \"id\": 1,\n      \"title\": \"string\",\n      \"description\": \"string\",\n      \"location\": \"string\",\n      \"event_date\": \"2026-05-01\",\n      \"capacity\": 100,\n      \"registrations_count\": 10\n    }\n  ],\n  \"meta\": {\n    \"current_page\": 1,\n    \"last_page\": 1,\n    \"per_page\": 10,\n    \"total\": 1\n  }\n}"
            },
            {
              "name": "Unauthorized 401",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 401,
              "body": "{\n  \"message\": \"Unauthorized user\"\n}"
            }
          ]
        },
        {
          "name": "Create Event (ADMIN)",
          "request": {
            "url": {
              "host": "{{baseUrl}}",
              "path": "api/v1/events",
              "query": [],
              "raw": "{{baseUrl}}/api/v1/events"
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Tech Conference 2026\",\"description\":\"Annual technology conference.\",\"location\":\"Almaty\",\"event_date\":\"2026-06-15\",\"capacity\":100}"
            },
            "description": "Creates a new event. Accessible only for ADMIN users."
          },
          "response": [
            {
              "name": "Success 201",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 201,
              "body": "{\n  \"message\": \"create success\",\n  \"data\": {\n    \"id\": 1,\n    \"title\": \"Tech Conference 2026\",\n    \"event_date\": \"2026-06-15\"\n  }\n}"
            },
            {
              "name": "Unauthorized 401",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 401,
              "body": "{\n  \"message\": \"Unauthorized user\"\n}"
            },
            {
              "name": "Forbidden 403",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 403,
              "body": "{\n  \"message\": \"Forbidden\"\n}"
            },
            {
              "name": "Validation error 422",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 422,
              "body": "{\n  \"message\": \"Validation error\",\n  \"errors\": {\n    \"title\": [\"The title field is required.\"],\n    \"description\": [\"The description field is required.\"],\n    \"location\": [\"The location field is required.\"],\n    \"event_date\": [\"The event date field is required.\"],\n    \"capacity\": [\"The capacity field is required.\"]\n  }\n}"
            }
          ]
        },
        {
          "name": "Event Details",
          "request": {
            "url": {
              "host": "{{baseUrl}}",
              "path": "api/v1/events/:id",
              "query": [],
              "raw": "{{baseUrl}}/api/v1/events/:id",
              "variable": [
                { "id": "id", "key": "id", "value": "1", "description": "The ID of the event." }
              ]
            },
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": null,
            "description": "Returns detailed information about an event. participants includes only those with CONFIRMED registrations. Participant fields: id, name, phone."
          },
          "response": [
            {
              "name": "Success 200",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 200,
              "body": "{\n  \"data\": {\n    \"id\": 1,\n    \"title\": \"string\",\n    \"description\": \"string\",\n    \"location\": \"string\",\n    \"event_date\": \"2026-06-15\",\n    \"capacity\": 100,\n    \"registrations_count\": 10,\n    \"participants\": [\n      { \"id\": 1, \"name\": \"string\", \"phone\": \"+77001234567\" }\n    ]\n  }\n}"
            },
            {
              "name": "Unauthorized 401",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 401,
              "body": "{\n  \"message\": \"Unauthorized user\"\n}"
