              "name": "Not found 404",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 404,
              "body": "{\n  \"message\": \"Not found\"\n}"
            }
          ]
        },
        {
          "name": "Update Event (ADMIN)",
          "request": {
            "url": {
              "host": "{{baseUrl}}",
              "path": "api/v1/events/:id",
              "query": [],
              "raw": "{{baseUrl}}/api/v1/events/:id",
              "variable": [
                { "id": "id", "key": "id", "value": "1", "description": "The ID of the event." }
              ]
            },
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Tech Conference 2026 Updated\",\"description\":\"Updated description.\",\"location\":\"Almaty\",\"event_date\":\"2026-07-20\",\"capacity\":150}"
            },
            "description": "Fully updates an event. Returns 409 if new capacity is less than confirmed registrations count."
          },
          "response": [
            {
              "name": "Success 200",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 200,
              "body": "{\n  \"message\": \"update success\",\n  \"data\": {\n    \"id\": 1,\n    \"title\": \"string\",\n    \"description\": \"string\",\n    \"location\": \"string\",\n    \"event_date\": \"2026-07-20\",\n    \"capacity\": 150\n  }\n}"
            },
            {
              "name": "Unauthorized 401",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 401,
              "body": "{\n  \"message\": \"Unauthorized user\"\n}"
            },
            {
              "name": "Forbidden 403",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 403,
              "body": "{\n  \"message\": \"Forbidden\"\n}"
            },
            {
              "name": "Not found 404",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 404,
              "body": "{\n  \"message\": \"Not found\"\n}"
            },
            {
              "name": "Conflict 409 — capacity too low",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 409,
              "body": "{\n  \"message\": \"The capacity must be greater than number of confirmed registrations\"\n}"
            },
            {
              "name": "Validation error 422",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 422,
              "body": "{\n  \"message\": \"Validation error\",\n  \"errors\": {\n    \"event_date\": [\"The event date does not match the format Y-m-d.\"]\n  }\n}"
            }
          ]
        },
        {
          "name": "Delete Event (ADMIN)",
          "request": {
            "url": {
              "host": "{{baseUrl}}",
              "path": "api/v1/events/:id",
              "query": [],
              "raw": "{{baseUrl}}/api/v1/events/:id",
              "variable": [
                { "id": "id", "key": "id", "value": "1", "description": "The ID of the event." }
              ]
            },
            "method": "DELETE",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": null,
            "description": "Deletes an event and all related registrations. Accessible only for ADMIN."
          },
          "response": [
            {
              "name": "Success 200",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 200,
              "body": "{\n  \"message\": \"delete success\"\n}"
            },
            {
              "name": "Unauthorized 401",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 401,
              "body": "{\n  \"message\": \"Unauthorized user\"\n}"
            },
            {
              "name": "Forbidden 403",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
