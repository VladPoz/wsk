    {
      "name": "Registrations",
      "description": "Registration management. Statuses: PENDING | CONFIRMED | CANCELLED.",
      "item": [
        {
          "name": "Create Registration",
          "request": {
            "url": {
              "host": "{{baseUrl}}",
              "path": "api/v1/registrations",
              "query": [],
              "raw": "{{baseUrl}}/api/v1/registrations"
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"event_id\":1}"
            },
            "description": "Creates a new PENDING registration. participant_id is resolved from the authenticated user profile. Returns 422 with message 'Create a participant profile' if no profile exists."
          },
          "response": [
            {
              "name": "Success 201",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 201,
              "body": "{\n  \"message\": \"create success\",\n  \"data\": {\n    \"id\": 1,\n    \"status\": \"PENDING\"\n  }\n}"
            },
            {
              "name": "Unauthorized 401",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 401,
              "body": "{\n  \"message\": \"Unauthorized user\"\n}"
            },
            {
              "name": "Conflict 409 — already registered",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 409,
              "body": "{\n  \"message\": \"Conflict\"\n}"
            },
            {
              "name": "Validation error 422",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 422,
              "body": "{\n  \"message\": \"Validation error\",\n  \"errors\": {\n    \"event_id\": [\"The event id field is required.\"]\n  }\n}"
            },
            {
              "name": "No participant profile 422",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "code": 422,
              "body": "{\n  \"message\": \"Create a participant profile\"\n}"
            }
          ]
        },
        {
          "name": "Confirm Registration (ADMIN)",
          "request": {
            "url": {
              "host": "{{baseUrl}}",
              "path": "api/v1/registrations/:id/confirm",
              "query": [],
              "raw": "{{baseUrl}}/api/v1/registrations/:id/confirm",
              "variable": [
                { "id": "id", "key": "id", "value": "1", "description": "The ID of the registration." }
              ]
            },
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": null,
            "description": "Confirms a PENDING registration. Only ADMIN can confirm. Returns 409 if event capacity is exceeded."
